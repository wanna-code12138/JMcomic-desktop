{
  "name": "jmcomic-desktop",
  "version": "1.3.4",
  "description": "禁漫天堂桌面客户端 — WinUI 3 风格漫画阅读器",
  "main": "./out/main/index.js",
  "author": "JMComic Desktop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanna-code12138/JMcomic-desktop.git"
  },
  "homepage": "https://github.com/wanna-code12138/JMcomic-desktop#readme",
  "bugs": {
    "url": "https://github.com/wanna-code12138/JMcomic-desktop/issues"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "postpackage": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@tanstack/react-virtual": "^3.11.0",
    "archiver": "7.0.1",
    "cheerio": "^1.0.0",
    "got": "^13.0.0",
    "https-proxy-agent": "^7.0.5",
    "opencc-js": "1.4.2",
    "pdfkit": "0.20.2",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/archiver": "6.0.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.jmcomic.desktop",
    "productName": "JMComic Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "build/icons/icon-256.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "wanna-code12138",
      "repo": "JMcomic-desktop"
    },
    "portable": {
      "artifactName": "JMComic Desktop Portable ${version}.exe"
    }
  }
}
